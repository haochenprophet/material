; PHP-FPM pool 示例（PHP 8.4）
; 生产按 CPU/内存调整；不要用 root 运行。
[www]
user = www-data
group = www-data
listen = /run/php/php8.4-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 20
pm.start_servers = 5
pm.min_spare_servers = 3
pm.max_spare_servers = 8
pm.max_requests = 500
request_terminate_timeout = 30s
php_admin_value[error_log] = /var/log/php8.4-fpm-material.log
php_admin_flag[log_errors] = on
php_admin_value[expose_php] = Off
